# One round trip of NTP-style clock synchronization. All values are nanoseconds.

# Receiver clock when the request was sent.
uint64 t1
---
# Echo of the request value.
uint64 t1

# Device clock when the request was received.
# Same clock as the message timestamps on the wire.
uint64 t2

# Device clock just before the response was sent.
uint64 t3

{
  "rules": [
    { "id": "@secretlint/secretlint-rule-preset-recommend" },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Apple device UDID",
            "pattern": "/\\b[0-9A-Fa-f]{8}-[0-9A-Fa-f]{16}\\b/g",
            "allows": ["/00008140-001234567890ABCD/", "/00008110-00DEADBEEF000001/"]
          },
          {
            "name": "Apple Team ID",
            "pattern": "/DEVELOPMENT_TEAM\\s*=\\s*[A-Z0-9]{10}\\b/g"
          }
        ]
      }
    }
  ]
}
